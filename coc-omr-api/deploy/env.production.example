# Copy values into .env on your cloud server (Oracle VM, Render, etc.)
# Do not commit real passwords.

APP_NAME="COC OMR API"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.your-subdomain.example

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=coc_omr
DB_USERNAME=coc_omr
DB_PASSWORD=CHANGE_ME

AUTO_VERIFY_EMAIL=false

BREVO_API_KEY=

# Vercel web portal URL (no trailing slash)
FRONTEND_URL=https://your-app.vercel.app
CORS_EXTRA_ORIGINS=

SANCTUM_STATEFUL_DOMAINS=your-app.vercel.app,api.your-subdomain.example

MOBILE_VERIFY_REDIRECT=edu.coc.omr://login-callback

# Email — pick ONE path:
#
# RECOMMENDED (Brevo HTTP API — works when SMTP fails on Render):
# BREVO_API_KEY = from Brevo → Settings → SMTP & API → API Keys → Create
# MAIL_FROM_ADDRESS = verified sender (alex.balaba.coc@phinmaed.com)
# MAIL_FROM_NAME = COC OMR
#
# OR legacy SMTP (all MAIL_* below):
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your-id@smtp-brevo.com
MAIL_PASSWORD=your-smtp-key
MAIL_FROM_ADDRESS=your-verified-sender@gmail.com
MAIL_FROM_NAME="COC OMR"
